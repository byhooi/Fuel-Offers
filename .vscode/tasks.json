{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "git: pull on open",
      "type": "shell",
      "command": "git pull --ff-only",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true,
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}